# Copy to .env and fill in your own values. NEVER commit .env to git.

# ---- Required ----

# ElevenLabs Scribe v2 Realtime — for live transcription
# Get one at https://elevenlabs.io → Profile → API Keys
# Must have Speech-to-Text permission
ELEVENLABS_API_KEY=

# Anthropic Claude — for live coaching + post-call debrief
# Get one at https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ---- Optional: post-call email ----

# Gmail account that will send the debrief to itself
GMAIL_USER=

# Gmail App Password (NOT your regular password)
# Generate at https://myaccount.google.com/apppasswords
# (requires 2FA enabled on your Google account)
GMAIL_APP_PASSWORD=

# ---- Optional: post-call HubSpot note ----

# HubSpot Service Key (or legacy Private App token)
# Create one at HubSpot → Settings → Integrations → Service Keys
# Scopes required:
#   crm.objects.contacts.read
#   crm.objects.contacts.write
HUBSPOT_ACCESS_TOKEN=

# HubSpot API base URL.
#   US portals: https://api.hubapi.com  (default)
#   EU portals: https://api.hubapi.com  (token prefix pat-eu1 routes automatically)
HUBSPOT_API_BASE=https://api.hubapi.com
